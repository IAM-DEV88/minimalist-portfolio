---
import Section from "../Section.astro";
import { certificates } from "@cv";
---

<Section title="Certificaciones" id="section4" i18n="section.certifications">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 w-full">
    {certificates.map((c) => (
      <a
        href={c.url}
        target="_blank"
        rel="noopener noreferrer"
        class="cert-card group relative bg-slate-800/60 border border-slate-700/80 rounded-2xl p-5 overflow-hidden hover:-translate-y-1 hover:border-cyan-500/70 transition-all duration-300 will-change-transform flex flex-col gap-3"
      >
        <!-- Glow superior con gradiente -->
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-500/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="absolute -top-16 -right-16 w-40 h-40 bg-cyan-500/10 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <!-- Insignia del curso -->
        <div class="relative flex items-center justify-between gap-2">
          <div class="relative">
            <div class="absolute -inset-1.5 bg-gradient-to-br from-cyan-600 to-blue-600 rounded-xl blur opacity-0 group-hover:opacity-60 transition-opacity duration-300"></div>
            <img
              src={c.badge}
              alt={c.name}
              loading="lazy"
              decoding="async"
              width="80"
              height="80"
              class="relative w-16 h-16 object-contain rounded-xl bg-white/5 border border-slate-700/60 p-1.5 group-hover:border-cyan-500/50 transition-colors duration-300"
            />
          </div>
          <svg class="w-4 h-4 text-slate-500 group-hover:text-cyan-300 transition-colors duration-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </div>

        <!-- Nombre y fecha -->
        <div class="relative flex flex-col gap-1.5 min-w-0">
          <h3 class="text-sm font-bold text-white leading-snug group-hover:text-cyan-300 transition-colors duration-300 line-clamp-2">{c.name}</h3>
          <p class="text-[11px] text-slate-400 font-medium flex items-center gap-1.5">
            <span class="inline-flex items-center gap-1 text-cyan-400 font-semibold">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              {c.issuer}
            </span>
            <span class="text-slate-600">·</span>
            <span class="date-value">{c.date}</span>
          </p>
        </div>
      </a>
    ))}
  </div>
</Section>

<style>
  .cert-card { animation: cardIn 0.4s ease both; }
  @keyframes cardIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

  @media print {
    .cert-card { break-inside: avoid; page-break-inside: avoid; background: none !important; border: 1px solid #ddd !important; padding: 1rem !important; margin-bottom: 0.75rem !important; }
    .cert-card h3 { color: #000 !important; }
    .cert-card p { color: #333 !important; }
    .cert-card svg { display: none !important; }
    .cert-card img { width: 40px !important; height: 40px !important; }
  }
</style>